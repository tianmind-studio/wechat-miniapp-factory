.category-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #374151;
}

.category-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-item {
  flex: 1;
  min-width: 180rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #F3F4F6;
  font-size: 26rpx;
  color: #4B5563;
  transition: all 0.2s;
}

.category-item.active {
  background: #6366F1;
  color: #FFFFFF;
}

.topic-card {
  text-align: center;
}

.topic-text {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.5;
  margin: 24rpx 0;
  color: #1E1B4B;
}

.topic-level {
  font-size: 24rpx;
  color: #9CA3AF;
}

.action-area {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.action-area .btn-secondary {
  flex: 1;
}

.action-area .btn-primary {
  flex: 2;
}

.btn-primary[disabled] {
  background: #C7D2FE;
  color: #A5B4FC;
}
