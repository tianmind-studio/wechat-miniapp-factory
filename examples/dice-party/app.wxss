.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
  background: linear-gradient(180deg, #F5F3FF 0%, #EDE9FE 100%);
  color: #1E1B4B;
}

.section {
  margin-bottom: 32rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #6B7280;
  text-align: center;
  line-height: 1.5;
}

.card {
  border-radius: 16rpx;
  background: #FFFFFF;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(99, 102, 241, 0.1);
}

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #6366F1;
  color: #FFFFFF;
  padding: 24rpx 32rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #E0E7FF;
  color: #4338CA;
  padding: 20rpx 28rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.btn-secondary::after {
  border: none;
}

.dice-icon {
  font-size: 120rpx;
  text-align: center;
  margin: 40rpx 0;
}

.highlight {
  color: #6366F1;
  font-weight: 700;
}

.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: #E0E7FF;
  color: #4338CA;
  font-size: 24rpx;
  margin-right: 12rpx;
}
